# Cloud Deployment Environment Variables Template
# These values should be stored in GCP Secret Manager, not in a .env file
# This file is for reference only

# Transport mode (http for cloud, stdio for local)
MCP_TRANSPORT=http

# Server configuration (Cloud Run will set PORT automatically)
MCP_HOST=0.0.0.0
MCP_PORT=8080

# SMTP Configuration (stored as secrets in GCP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Kindle Configuration (stored as secrets in GCP)
KINDLE_EMAIL=your-kindle-email@kindle.com
FROM_EMAIL=your-email@gmail.com

# Optional: Default author name (stored as secret in GCP)
AUTHOR_NAME=Your Name

# Note: DO NOT store actual credentials in this file
# Use the deploy.sh script which will prompt you for these values
# and store them securely in GCP Secret Manager
